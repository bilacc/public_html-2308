// backend/prisma/schema.prisma
// Prisma ORM schema mapping the nekretnina table from your SQL dump

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model nekretnina {
  id              Int      @id @default(autoincrement())
  ime             String
  prezime         String
  telefon         String
  mobitel         String
  e_mail          String
  lokacija_id     String
  adresa          String
  status_id       String
  vrsta_id        String
  udaljenost      String
  povrsina        String
  stambenapovrsina String
  display         Int
  cijena          String
  cijenatocka     String
  ponuda_tjedna   Int
  new_built       Int
  must_sell       Int
  prvi_red_do_mora Int
  pogled_na_more  Int
  bazen           Int
  broj_soba       Int
  broj_kupatila   Int
  datum           String
  title_hr        String
  title_en        String
  title_ge        String
  opis_hr         String
  opis_en         String
  opis_ge         String
  PropertyImageURL0 String
  PropertyImageURL1 String
  PropertyImageURL2 String
  PropertyImageURL3 String
  PropertyImageURL4 String
  PropertyImageURL5 String
  PropertyImageURL6 String
  PropertyImageURL7 String
  PropertyImageURL8 String
}
